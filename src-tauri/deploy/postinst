#!/bin/bash
set -e

APP_NAME="vorak-estacion"
RESOURCE_DIR="/usr/lib/${APP_NAME}/resources"

echo "=== ${APP_NAME} post-installation ==="

if [ -f "/usr/share/applications/vorak-estacion.desktop" ]; then
    mkdir -p /etc/xdg/autostart 2>/dev/null || true
    cp "/usr/share/applications/vorak-estacion.desktop" /etc/xdg/autostart/ 2>/dev/null || true
fi

if [ -f "${RESOURCE_DIR}/99-vorak-estacion.rules" ]; then
    cp "${RESOURCE_DIR}/99-vorak-estacion.rules" /etc/udev/rules.d/ 2>/dev/null || true
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger 2>/dev/null || true
fi

echo "=== ${APP_NAME} post-installation complete ==="
echo "La app se abrira automaticamente al iniciar sesion del usuario actual."
