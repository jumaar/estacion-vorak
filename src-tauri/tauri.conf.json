{
  "productName": "vorak-estacion",
  "version": "1.0.0",
  "identifier": "app.vorak.estacion",
  "build": {
    "frontendDist": "../static",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' https://cdn.socket.io https://challenges.cloudflare.com 'unsafe-inline'; connect-src 'self' https: wss: ws:; frame-src https://challenges.cloudflare.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "resources/config.json",
      "resources/fonts/*",
      "resources/99-vorak-estacion.rules",
      "resources/vorak-estacion.service"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
