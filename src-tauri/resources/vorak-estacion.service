[Unit]
Description=VORAK Estación de Pesaje
After=network.target graphical.target
Wants=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/vorak-estacion
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/vorak/.Xauthority
User=vorak
Group=vorak
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
