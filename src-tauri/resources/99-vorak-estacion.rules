# Reglas udev para la estación de pesaje VORAK
# Instalar en /etc/udev/rules.d/99-vorak-estacion.rules

# Báscula CH341 (serie) - 1a86:7523
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="7523", MODE="0666"

# Impresora GEZHI (usblp) - 0483:5720
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="5720", MODE="0666"

# TAG/RFID CH341 - 1a86:e010
SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{idProduct}=="e010", MODE="0666"

# Puerto serie para bascula
KERNEL=="ttyUSB*", MODE="0666"

# Puerto impresora USB
KERNEL=="usb/lp*", MODE="0666"
